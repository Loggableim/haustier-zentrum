# Cache-Control für Cloudflare Pages
# WICHTIG: Security-Header NUR in der /* Regel — sonst joint CF-Pages
# doppelt gesetzte Header mit Komma (Join-Bug → Browser verwirft sie).

# Statische Assets: 1 Jahr Cache (immutable, hash-gebundene Dateien)
/images/*.webp
  Cache-Control: public, max-age=31536000, immutable

/images/*.png
  Cache-Control: public, max-age=31536000, immutable

# CSS: 7 Tage Cache (ändert sich selten, aber nicht hash-gebunden)
/css/*
  Cache-Control: public, max-age=604800, must-revalidate

# Artikel: 1 Stunde CDN-Cache.
# CF Pages serviert /artikel/<slug> (ohne .html) — der Wildcard matcht beides.
/artikel/*
  Cache-Control: public, max-age=3600, must-revalidate

# Statische Unterseiten (extensionless — CF 308-redirects .html und /)
/about
  Cache-Control: public, max-age=3600, must-revalidate
/impressum
  Cache-Control: public, max-age=3600, must-revalidate
/datenschutz
  Cache-Control: public, max-age=3600, must-revalidate
/affiliate-hinweis
  Cache-Control: public, max-age=3600, must-revalidate

# RSS + Sitemap: 4 Stunden
/rss.xml
  Cache-Control: public, max-age=14400, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=14400, must-revalidate
/sitemap-articles.xml
  Cache-Control: public, max-age=14400, must-revalidate
/sitemap-static.xml
  Cache-Control: public, max-age=14400, must-revalidate

# 404: nicht cachen
/404.html
  Cache-Control: no-cache, no-store, must-revalidate

# TXT-Dateien (robots, IndexNow, ads): 1 Tag
/*.txt
  Cache-Control: public, max-age=86400, must-revalidate

# Catch-all: Security-Header für ALLE Pfade (inkl. Root).
# HSTS: 1 Jahr, includeSubDomains (kein preload — erfordert separate Einreichung).
# Cache-Control hier bewusst NICHT setzen — sonst Join-Bug mit den
# spezifischeren Regeln oben.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
