R / f\\\"{slug}.html\\\").stat().st_mtime\\n-            new_lastmod = time.strftime(\\\"%Y-%m-%dT%H:%M:%S+00:00\\\", time.gmtime(mt))\\n-            article_parts.append(\\n-                f\\\"  <url>\\\\n    <loc>{new_loc}</loc>\\\\n    <lastmod>{new_lastmod}</lastmod>\\\\n    <changefreq>monthly</changefreq>\\\\n    <priority>0.7</priority>\\\\n  </url>\\\"\\n-            )\\n-        else:\\n-            # Static URL — normalize\\n-            new_loc = old_loc.rstrip(\\\"/\\\") + \\\"/\\\"\\n-            if new_loc == f\\\"{SITE}/\\\":\\n-                new_loc = f\\\"{SITE}/\\\"\\n-            if new_loc in seen_static:\\n-                continue\\n-            seen_static.add(new_loc)\\n-            src = static_map.get(new_loc)\\n-            if src and src.exists():\\n-                mt = (mtime_cache or {}).get(src.name)\\n-                if mt is None:\\n-                    mt = src.stat().st_mtime\\n-                new_lastmod = time.strftime(\\\"%Y-%m-%dT%H:%M:%S+00:00\\\", time.gmtime(mt))\\n-            else:\\n-                new_lastmod = old_lastmod\\n-            freq = \\\"daily\\\" if new_loc == f\\\"{SITE}/\\\" else \\\"monthly\\\"\\n-            prio = \\\"1.0\\\" if new_loc == f\\\"{SITE}/\\\" else \\\"0.5\\\"\\n-            static_parts.append(\\n-                f\\\"  <url>\\\\n    <loc>{new_loc}</loc>\\\\n    <lastmod>{new_lastmod}</lastmod>\\\\n    <changefreq>{freq}</changefreq>\\\\n    <priority>{prio}</priority>\\\\n  </url>\\\"\\n-            )\\n+\\n+    # Add all articles\\n+    for p in sorted(ART_DIR.glob(\\\"*.html\\\")):\\n+        slug = p.name[:-5]\\n+        loc = f\\\"{SITE}/artikel/{slug}\\\"\\n+        mt = _extract_date_modified(p)\\n+        if mt is None:\\n+            mt = (mtime_cache or {}).get(f\\\"{slug}.html\\\")\\n+        if mt is None:\\n+            mt = p.stat().st_mtime\\n+        new_lastmod = time.strftime(\\\"%Y-%m-%dT%H:%M:%S+00:00\\\", time.gmtime(mt))\\n+        article_parts.append(\\n+    