u003cscript type=\\\"application/ld+json\\\"\\u003e')] + new_json + text[end:]\\n        except Exception:\\n            pass\\n    file_path.write_text(text, encoding='utf-8')\\n\\nfor f in ART_DIR.glob('*.html'):\\n    process_file(f)\\nprint('Processed', len(list(ART_DIR.glob('*.html'))), 'files')\\nPY\",\"timeout\":120,\"workdir\":\"C:\\\\sidekick\\\\home\\\\spaces\\\\haustier-zentrum\"}"
