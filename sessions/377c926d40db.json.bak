            "name": "write_file",
            "arguments": "{\"content\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"\\n_bulk_fix_articles.py — Massive bulk fix for all article pages.\\n\\nBatch operations:\\n1. Fix all nav bars: add Datenschutz link after Impressum\\n2. Fix all footers: add Datenschutz link, fix incorrect Datenschutz→Impressum links\\n3. Fix all cookie banners: Ablehnen button, /datenschutz.html link, proper consent\\n4. Add health disclaimers to health-critical articles\\n5. Fix footer \\\"Impressum\\\" links that should be \\\"Datenschutz\\\"\\n\\\"\\\"\\\"\\nimport re, os\\nfrom pathlib import Path\\n\\nROOT = Path(r\\\"C:\\\\sidekick\\\\home\\\\spaces\\\\haustier-zentrum\\\")\\nART_DIR = ROOT / \\\"artikel\\\"\\n\\n# Health-critical articles that need medical disclaimers\\nHEALTH_ARTICLES = [\\n    \\\"erste-hilfe-haustiere-notfall-ratgeber\\\",\\n    \\\"hunde-krankheiten-symptome-erste-hilfe\\\",\\n    \\\"hunde-hausmittel\\\",\\n    \\\"hunde-gesundheit\\\",\\n    \\\"hundeallergien\\\",\\n    \\\"hunde-uebergewicht\\\",\\n    \\\"hunde-zahnpflege\\\",\\n    \\\"hundeernaehrung\\\",\\n    \\\"hunde-ernaehrung-barf-trocken-nass\\\",\\n    \\\"katzenkrankheiten-erkennen\\\",\\n    \\\"katzen-impfungen-vorsorge\\\",\\n    \\\"katzen-kastration-sterilisation\\\",\\n    \\\"katzen-ernaehrung\\\",\\n    \\\"katzen-zahnpflege\\\",\\n    \\\"katzenfutter-selber-machen\\\",\\n    \\\"katzenfutter-vergleich-2026\\\",\\n    \\\"allergiker-haustiere\\\",\\n    \\\"allergien-bei-hund-und-katze-2026-umwelt-futter-und-fell-ganzheitliche-strategie\\\",\\n    \\\"kaninchen-ernaehrung-gesundheit\\\",\\n    \\\"meerschweinchen-ernaehrung-vitamin-c\\\",\\n    \\\"seniorkatzen-pflege-ernaehrung-gesundheit\\\",\\n    \\\"tierarztkosten\\\",\\n    \\\"zeckenschutz-flohschutz-hund\\\",\\n    \\\"hundeversicherung\\\",\\n    \\\"wellensittich-ernaehrung-gesundheit\\\",\\n    \\\"wellensittich-ernaehrung-futter\\\",\\n    \\\"ganzheitliche-hundegesundheit-2026-wie-sie-krankheiten-fruehzeitig-erkennen-und-\\\",\\n    \\\"kleintier-gesundheit-2026-warum-meerschweinchen-kaninchen-und-hamster-mehr-tiera\\\",\\n    \\\"notfall-checkliste-2026-erste-hilfe-fuer-hund-katze-und-kleintier-was-jede-halte\\\",\\n    \\\"naehrstoff-kompass-2026-so-waehlen-sie-das-richtige-futter-fuer-hund-katze-und-k\\\",\\n    \\\"stille-signale-erkennen-wie-hunde-und-katzen-schmerzen-zeigen-und-was-halter-202\\\",\\n    \\\"altersgerechte-haltung-2026-welche-beduerfnisse-hunde-katzen-und-kleintiere-im-l\\\",\\n    \\\"hunde-hausmittel\\\",\\n]\\n\\n# Emergency notice for health articles\\nHEALTH_DISCLAIMER = '''\\n<!-- MEDICAL DISCLAIMER -->\\n<div class=\\\"health-disclaimer\\\" style=\\\"background:#fff3e0;border-left:4px solid #FF9800;padding:1rem 1.2rem;margin-bottom:1.5rem;border-radius:0 8px 8px 0;font-size:.9rem;\\\">\\n  <strong>⚠️ Wichtiger Hinweis:</strong> Dieser Artikel dient nur zu Informationszwecken und ersetzt <strong>keine tierärztliche Beratung, Diagnose oder Behandlung</strong>. Bei gesundheitlichen Problemen Ihres Tieres wenden Sie sich bitte umgehend an einen Tierarzt.\\n</div>'''\\n\\nHEALTH_NOTICE = '''\\n<!-- EMERGENCY NOTICE -->\\n<div class=\\\"emergency-notice\\\" style=\\\"background:#fdecea;border-left:4px solid #d32f2f;padding:1rem 1.2rem;margin-bottom:1.5rem;border-radius:0 8px 8px 0;font-size:.9rem;\\\">\\n  <strong>🚨 Notfall?</strong> Bei akuten Symptomen wie Atemnot, Krampfanfällen, starken Blutungen oder Vergiftungsverdacht zögern Sie nicht – fahren Sie sofort zum nächsten Tierarzt oder zur Tierklinik!\\n</div>'''\\n\\n# Articles with emergency content\\nEMERGENCY_ARTICLES = [\\n    \\\"erste-hilfe-haustiere-notfall-ratgeber\\\",\\n    \\\"hunde-krankheiten-symptome-erste-hilfe\\\",\\n    \\\"hunde-hausmittel\\\",\\n    \\\"notfall-checkliste-2026-erste-hilfe-fuer-hund-katze-und-kleintier-was-jede-halte\\\",\\n]\\n\\nstats = {\\\"nav\\\": 0, \\\"footer\\\": 0, \\\"cookie\\\": 0, \\\"datenschutz_link\\\": 0, \\\"health\\\": 0, \\\"emergency\\\": 0, \\\"adsense_consent\\\": 0}\\n\\nfor p in sorted(ART_DIR.glob(\\\"*.html\\\")):\\n    text = p.read_text(encoding=\\\"utf-8\\\")\\n    original = text\\n    slug = p.name[:-5]\\n\\n    # === FIX 1: Nav — add Datenschutz link ===\\n    # Find: simple-link Impressum entry, add Datenschutz after it\\n    nav_pattern = r'(<li class=\\\"simple-link\\\"><a href=\\\"/impressum\\\\.html\\\"[^>]*>Impressum</a></li>)'\\n    nav_replacement = r'\\\\1\\\\n        <li class=\\\"simple-link\\\"><a href=\\\"/datenschutz.html\\\">Datenschutz</a></li>'\\n    text, n = re.subn(nav_pattern, nav_replacement, text, count=1)\\n    if n:\\n        stats[\\\"nav\\\"] += 1\\n\\n    # === FIX 2: Footer — add Datenschutz link where missing ===\\n    # Pattern: footer with \\\"Impressum\\\" but no \\\"Datenschutz\\\"\\n    footer_pattern = r'(<a href=\\\"/impressum\\\\.html\\\"[^>]*>Impressum</a>)(?![\\\\s\\\\S]*?<a href=\\\"/datenschutz\\\\.html\\\")'\\n    text, n = re.subn(footer_pattern, r'\\\\1 · <a href=\\\"/datenschutz.html\\\">Datenschutz</a>', text, count=1)\\n    if n:\\n        stats[\\\"footer\\\"] += 1\\n\\n    # === FIX 3: Footer — replace incorrect \\\"Datenschutz\\\" link pointing to impressum ===\\n    text, n = re.subn(\\n        r'<a href=\\\"/impressum\\\\.html\\\"[^>]*>Datenschutz</a>',\\n        '<a href=\\\"/datenschutz.html\\\">Datenschutz</a>',\\n        text, count=1\\n    )\\n    if n:\\n        stats[\\\"datenschutz_link\\\"] += 1\\n\\n    # === FIX 4: Cookie banner — update link and add Ablehnen ===\\n    # Replace old-style cookie banner with new one\\n    \\n    # Pattern 1: Old banner with /impressum.html link\\n    text, n = re.subn(\\n        r'<a href=\\\"/impressum\\\\.html\\\"[^>]*>Mehr Infos</a>',\\n        '<a href=\\\"/datenschutz.html\\\" style=\\\"color:#FFB74D;\\\">Mehr Infos</a>',\\n        text\\n    )\\n    \\n    # Pattern 2: Old Akzeptieren button (simple localStorage set)\\n    text, n = re.subn(\\n        r'<button onclick=\\\"localStorage\\\\.setItem\\\\(\\\\'cookieConsent\\\\',\\\\'1\\\\'\\\\);document\\\\.getElementById\\\\(\\\\'cookieBanner\\\\'\\\\)\\\\.classList\\\\.remove\\\\(\\\\'show\\\\'\\\\)\\\">Akzeptieren</button>',\\n        '<button onclick=\\\"window.acceptCookies()\\\">Akzeptieren</button>\\\\n  <button onclick=\\\"window.declineCookies()\\\" style=\\\"background:#555;\\\">Ablehnen</button>',\\n        text, count=1\\n    )\\n    if n:\\n        stats[\\\"cookie\\\"] += 1\\n    \\n    # Pattern 3: Old cookie script block \\n    text, n = re.subn(\\n        r'script>\\\\n// Cookie-Consent: Banner nur anzeigen wenn nicht bereits akzeptiert\\\\nif\\\\(!localStorage\\\\.getItem\\\\(\\\\'cookieConsent\\\\'\\\\)\\\\)\\\\{\\\\n  document\\\\.getElementById\\\\(\\\\'cookieBanner\\\\'\\\\)\\\\?\\\\.classList\\\\.add\\\\(\\\\'show\\\\'\\\\);\\\\n\\\\}',\\n        'script>\\\\n// Cookie-Consent-Management\\\\nwindow.cookieState = localStorage.getItem(\\\\'cookieConsent\\\\');\\\\n\\\\nwindow.acceptCookies = function() {\\\\n  localStorage.setItem(\\\\'cookieConsent\\\\', \\\\'accepted\\\\');\\\\n  document.getElementById(\\\\'cookieBanner\\\\').classList.remove(\\\\'show\\\\');\\\\n};\\\\n\\\\nwindow.declineCookies = function() {\\\\n  localStorage.setItem(\\\\'cookieConsent\\\\', \\\\'declined\\\\');\\\\n  document.getElementById(\\\\'cookieBanner\\\\').classList.remove(\\\\'show\\\\');\\\\n};\\\\n\\\\nif (!window.cookieState) {\\\\n  document.addEventListener(\\\\'DOMContentLoaded\\\\', function() {\\\\n    document.getElementById(\\\\'cookieBanner\\\\')?.classList.add(\\\\'show\\\\');\\\\n  });\\\\n}',\\n        text, count=1\\n    )\\n    if n:\\n        stats[\\\"cookie\\\"] += 1\\n\\n    # === FIX 5: Add health disclaimer ===\\n    if slug in HEALTH_ARTICLES:\\n        # Insert disclaimer after <main> or after <header> or after article content starts\\n        # Target: right after the opening <main> tag, before article content\\n        if HEALTH_DISCLAIMER not in text:\\n            text, n = re.subn(\\n                r'(<main>)\\\\s*\\\\n?\\\\s*(<div class=\\\"info-page\\\">|<article|<div class=\\\"article-content\\\"|<div class=\\\"container\\\">|<div class=\\\"content\\\">)',\\n                f'\\\\\\\\1\\\\n{HEALTH_DISCLAIMER}\\\\\\\\2',\\n                text, count=1\\n            )\\n            if n:\\n                stats[\\\"health\\\"] += 1\\n            else:\\n                # Try alternative: insert after first paragraph inside main\\n                text, n = re.subn(\\n                    r'(<main>.*?)(<h1|<h2|<p[^>]*>)',\\n                    f'\\\\\\\\1{HEALTH_DISCLAIMER}\\\\\\\\2',\\n                    text, count=1\\n                )\\n                if n:\\n                    stats[\\\"health\\\"] += 1\\n\\n    # === FIX 6: Add emergency notice for critical articles ===\\n    if slug in EMERGENCY_ARTICLES:\\n        if HEALTH_NOTICE not in text:\\n            text, n = re.subn(\\n                r'(<main>.*?)(<h1|<h2)',\\n                f'\\\\\\\\1{HEALTH_NOTICE}\\\\\\\\2',\\n                text, count=1\\n            )\\n            if n:\\n                stats[\\\"emergency\\\"] += 1\\n\\n    # === FIX 7: Make AdSense loading conditional on consent ===\\n    # Block: wrap AdSense script in consent check\\n    # We need to be careful — the script tag pattern\\n    text, n = re.subn(\\n        r'(<script async src=\\\"https://pagead2\\\\.googlesyndication\\\\.com/pagead/js/adsbygoogle\\\\.js\\\\?client=ca-pub-9094916118868532\\\"[^>]*></script>)',\\n        '<script>\\\\n// AdSense nur mit Einwilligung laden\\\\nif (localStorage.getItem(\\\\'cookieConsent\\\\') === \\\\'accepted\\\\') {\\\\n  var s = document.createElement(\\\\'script\\\\');\\\\n  s.async = true;\\\\n  s.src = \\\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9094916118868532\\\";\\\\n  s.crossOrigin = \\\"anonymous\\\";\\\\n  document.head.appendChild(s);\\\\n}\\\\n</script>',\\n        text, count=1\\n    )\\n    if n:\\n        stats[\\\"adsense_consent\\\"] += 1\\n\\n    if text != original:\\n        p.write_text(text, encoding=\\\"utf-8\\\")\\n\\nprint(f\\\"=== Bulk Fix Results ===\\\")\\nprint(f\\\"Nav Datenschutz added: {stats['nav']}\\\")\\nprint(f\\\"Footer Datenschutz added: {stats['footer']}\\\")\\nprint(f\\\"Wrong Datenschutz links fixed: {stats['datenschutz_link']}\\\")\\nprint(f\\\"Cookie banners upgraded: {stats['cookie']}\\\")\\nprint(f\\\"Health disclaimers added: {stats['health']}\\\")\\nprint(f\\\"Emergency notices added: {stats['emergency']}\\\")\\nprint(f\\\"AdSense made consent-aware: {stats['adsense_consent']}\\\")\\nprint(\\\"Done.\\\")\\n\", \"path\": \"C:\\\\sidekick\\\\home\\\\spaces\\\\haustier-zentrum\\\\_bulk_fix_articles.py\"}"
          }
