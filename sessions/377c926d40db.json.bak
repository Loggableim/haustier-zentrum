      "role": "tool",
      "name": "read_file",
      "content": "{\"content\": \"     1|#!/bin/bash\\n     2|# Auto-Deploy Script — Haustierzentrum\\n     3|#\\n     4|# Reihenfolge:\\n     5|#   1. Refresh Sitemap + canonicals (idempotent)\\n     6|#   2. Generate RSS feed\\n     7|#   3. Git add + commit + push\\n     8|#\\n     9|# `set -e` sorgt dafür, dass bei Fehler sofort abgebrochen wird.\\n    10|# `python3` ist Fallback falls `python` nicht verfügbar (Linux/Mac).\\n    11|\\n    12|set -e\\n    13|cd \\\"$(dirname \\\"$0\\\")\\\"\\n    14|\\n    15|# Python finden (Windows: python, Linux: python3)\\n    16|PY=$(command -v python3 || command -v python)\\n    17|if [ -z \\\"$PY\\\" ]; then\\n    18|    echo \\\"ERROR: Python nicht gefunden\\\"\\n    19|    exit 1\\n    20|fi\\n    21|\\n    22|echo \\\"=== Deploy $(date +%Y-%m-%d\\\\ %H:%M:%S) ===\\\"\\n    23|echo \\\"\\\"\\n    24|\\n    25|# 1. Sitemap + canonicals refresh (legt sitemap.xml neu an wenn nötig)\\n    26|echo \\\"[1/3] Refreshing sitemap...\\\"\\n    27|$PY _refresh_indexing.py\\n    28|\\n    29|# 2. RSS-Feed neu generieren\\n    30|echo \\\"[2/3] Generating RSS feed...\\\"\\n    31|$PY _generate_feed.py --quiet\\n    32|\\n    33|# 3. Git commit + push\\n    34|echo \\\"[3/3] Committing + pushing...\\\"\\n    35|\\n    36|# Stat für Commit-Message\\n    37|ARTICLE_COUNT=$(ls artikel/*.html 2>/dev/null | wc -l)\\n    38|RSS_ITEMS=$(grep -c '<item>' rss.xml 2>/dev/null || echo 0)\\n    39|SITEMAP_URLS=$(grep -c '<loc>' sitemap.xml 2>/dev/null || echo 0)\\n    40|\\n    41|# Nur committen wenn es Änderungen gibt\\n    42|if git diff --cached --quiet 2>/dev/null && git diff --quiet 2>/dev/null; then\\n    43|    echo \\\"Keine Änderungen — überspringe commit.\\\"\\n    44|    exit 0\\n    45|fi\\n    46|\\n    47|git add -A\\n    48|git commit -m \\\"Auto: $ARTICLE_COUNT articles, $SITEMAP_URLS sitemap URLs, $RSS_ITEMS RSS items ($(date +%Y-%m-%d))\\\"\\n    49|\\n    50|# Bei parallelen Pushs holt pull --rebase die Remote-Commits\\n    51|# und rebased unseren Commit drauf. Wenn Konflikte: Abbruch.\\n    52|echo \\\"Pulling remote changes (rebase)...\\\"\\n    53|if ! git pull --rebase --autostash; then\\n    54|    echo \\\"\\\"\\n    55|    echo \\\"ERROR: git pull --rebase failed (likely merge conflicts).\\\"\\n    56|    echo \\\"Resolve manually: git status, fix conflicts, then git rebase --continue\\\"\\n    57|    echo \\\"After fixing, just run ./deploy.sh again.\\\"\\n    58|    exit 1\\n    59|fi\\n    60|\\n    61|git push\\n    62|\\n    63|echo \\\"\\\"\\n    64|echo \\\"--- DEPLOYED ---\\\"\", \"total_lines\": 63, \"file_size\": 1932, \"truncated\": false, \"is_binary\": false, \"is_image\": false}",
