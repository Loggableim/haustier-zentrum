er('click', function(e){\\n   236|      if(window.innerWidth <= 900){ e.preventDefault(); li.classList.toggle('open'); }\\n   237|    });\\n   238|  }\\n   239|});\\n   240|document.querySelectorAll('.simple-link a, .mega-col a').forEach(function(a){\\n   241|  a.addEventListener('click', function(){\\n   242|    if(window.innerWidth <= 900){\\n   243|      document.querySelector('.main-nav').classList.remove('open');\\n   244|      var t = document.querySelector('.nav-toggle');\\n   245|      if(t) t.textContent = '\\\\u2630';\\n   246|    }\\n   247|  });\\n   248|});\\n   249|</script>\\n   250|<script>\\n   251|// Cookie-Consent: Banner nur anzeigen wenn nicht bereits akzeptiert\\n   252|if(!localStorage.getItem('cookieConsent')){\\n   253|  document.getElementById('cookieBanner')?.classList.add('show');\\n   254|}\\n   255|</script>\\n   256|</body>\\n   257|</html>\\n   258|\", \"total_lines\": 257, \"file_size\": 18063, \"truncated\": false, \"is_binary\": false, \"is_image\": false}",
