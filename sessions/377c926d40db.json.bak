      "name": "read_file",
      "snippet": "{\"content\": \"     1|# Cache-Control für Cloudflare Pages\\n     2|# Statische Assets: 1 Jahr Cache (immutable, hash-gebundene Dateien)\\n     3|/images/*.webp\\n     4|  Cache-Control: public, max-age=31536000, immutable\\n     5|  X-Content-Type-Options: nosniff\\n     6|\\n     7|/images/*.png\\n     8|  Cache-Control: public, max-age=31536000, immutable\\n     9|  X-Content-Type-Options: nosniff\\n    10|\\n    11|# CSS + JS: 7 Tage Cache (ändern sich selten, aber nicht hash-gebunden)\\n    12|/css/*\\n    13|  Cache-Control: public, max-age=604800, must-revalidate\\n    14|\\n    15|# HTML-Seiten: kurz cachen, aber immer frisch prüfen\\n    16|/artikel/*.html\\n    17|  Cache-Control: public, max-age=3600, must-revalidate\\n    18|\\n    19|# Startseite: 1 Stunde CDN-Cache\\n    20|/index.html\\n    21|  Cache-Control: public, max-age=3600, must-revalidate\\n    22|/\\n    23|  Cache-Control: public, max-age=3600, must-revalidate\\n    24|\\n    25|# RSS + Sitemap: 4 Stunden\\n    26|/rss.xml\\n    27|  Cache-Control: public, max-age=14400, must-revalidate\\n    28|/sitemap.xml\\n    29|  Cache-Control: public, max-age=14400, must-revalidate\\n    30|\\n    31|# 404: nicht cachen\\n    32|/404.html\\n    33|  Cache-Control: no-cache, no-store, must-revalidate\\n    34|\\n    35|# TXT-Dateien (robots, IndexNow, ads): 1 Tag\\n    36|/*.txt\\n    37|  Cache-Control: public, max-age=86400, must-revalidate\\n    38|\", \"total_lines\": 37, \"file_size\": 1125, \"truncated\": false, \"is_binary\": false, \"is_image\": false}",
