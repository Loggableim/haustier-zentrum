      "content": "{\"content\": \"     1|#!/usr/bin/env python3\\n     2|\\\"\\\"\\\"\\n     3|_refresh_indexing.py — Normalize URLs + refresh sitemap + ping search engines.\\n     4|\\n     5|Goal: every article has ONE canonical URL = https://haustierzentrum.com/artikel/<slug>\\n     6|(no .html, no trailing slash, no /artikel/-prefix bugs)\\n     7|\\n     8|This is what Cloudflare serves after 308 redirects, so picking this as canonical\\n     9|removes duplicate-URL confusion for Google and saves 2 redirects per inbound link.\\n    10|\\\"\\\"\\\"\\n    11|from __future__ import annotations\\n    12|import argparse\\n    13|import json\\n    14|import os\\n    15|import re\\n    16|import sys\\n    17|import time\\n    18|import urllib.request\\n    19|import urllib.error\\n    20|from pathlib import Path\\n    21|\\n    22|ROOT = Path(r\\\"C:\\\\sidekick\\\\home\\\\spaces\\\\haustier-zentrum\\\")\\n    23|ART_DIR = ROOT / \\\"artikel\\\"\\n    24|SITEMAP = ROOT / \\\"sitemap.xml\\\"\\n    25|SITE = \\\"https://haustierzentrum.com\\\"\\n    26|INDEXNOW_KEY = os.environ.get(\\\"INDEXNOW_KEY\\\", \\\"\\\")\\n    27|\\n    28|# Article slug set (only files actually in /artikel/)\\n    29|ARTICLE_SLUGS = {p.name[:-5] for p in ART_DIR.glob(\\\"*.html\\\")}\\n    30|# Slug that was historically a buggy og:url (no /artikel/ prefix)\\n    31|KNOWN_BAD_SLUGS = set(ARTICLE_SLUGS)\\n    32|\\n    33|\\n    34|def canon_for_slug(slug: str) -> str:\\n    35|    return f\\\"{SITE}/artikel/{slug}\\\"\\n    36|\\n    37|\\n    38|def _extract_date_modified(path: Path) -> float | None:\\n    39|    \\\"\\\"\\\"Try to find dateModified or datePublished in JSON-LD of an article.\\n    40|    Returns a unix timestamp or None.\\\"\\\"\\\"\\n    41|    try:\\n    42|        text = path.read_text(encoding=\\\"utf-8\\\")\\n    43|    except Exception:\\n    44|        return None\\n    45|    # Find the first script type=application/ld+json\\n    46|    m = re.search(r'<script[^>]*type=\\\"application/ld\\\\+json\\\"[^>]*>(.*?)</script>', text, re.DOTALL)\\n    47|    if not m:\\n    48|        return None\\n    49|    blob = m.group(1).strip()\\n    50|    # Try direct JSON first\\n    51|    data = None\\n    52|    try:\\n    53|        data = json.loads(blob)\\n    54|    except Exception:\\n    55|        # Sometimes HTML-escaped; try a relaxed parse\\n    56|        try:\\n    57|            data = json.loads(blob.replace(\\\"&quot;\\\", '\\\"').replace(\\\"&amp;\\\", \\\"&\\\"))\\n    58|        except Exception:\\n    59|            return None\\n    60|    # Search for dateModified or datePublished recursively\\n    61|    target = None\\n    62|    def walk(o):\\n    63|        nonlocal target\\n    64|        if isinstance(o, dict):\\n    65|            if \\\"dateModified\\\" in o:\\n    66|                target = o[\\\"dateModified\\\"]\\n    67|                return True\\n    68|            if \\\"datePublished\\\" in o and target is None:\\n    69|                target = o[\\\"datePublished\\\"]\\n    70|            for v in o.values():\\n    71|                if walk(v):\\n    72|                    return True\\n    73|        elif isinstance(o, list):\\n    74|            for v in o:\\n    75|                if walk(v):\\n    76|                    return True\\n    77|        return False\\n    78|    walk(data)\\n    79|    if not target:\\n    80|        return None\\n    81|    # Parse ISO date; if date-only, treat as midnight UTC\\n    82|    s = str(target)\\n    83|    try:\\n    84|        if re.match(r\\\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\\\", s):\\n    85|            return time.mktime(time.strptime(s, \\\"%Y-%m-%d\\\"))\\n    86|        return time.mktime(time.strptime(s[:19], \\\"%Y-%m-%dT%H:%M:%S\\\"))\\n    87|    except Exception:\\n    88|        return None\\n    89|\\n    90|\\n    91|def normalize_href(href: str) -> str:\\n    92|    \\\"\\\"\\\"Collapse .../artikel/foo.html and .../artikel/foo/ to .../artikel/foo.\\\"\\\"\\\"\\n    93|    if not href:\\n    94|        return href\\n    95|    h = href\\n    96|    if h.startswith(SITE):\\n    97|        h = h[len(SITE):]\\n    98|    elif h.startswith(\\\"https://www.haustier-zentrum.com\\\"):\\n    99|        h = h[len(\\\"https://www.haustier-zentrum.com\\\"):]\\n   100|    m = re.match(r\\\"^(/artikel/[A-Za-z0-9_\\\\-]+)\\\\.html$\\\", h)\\n   101|    if m:\\n   102|        return m.group(1)\\n   103|    m = re.match(r\\\"^(/artikel/[A-Za-z0-9_\\\\-]+)/$\\\", h)\\n   104|    if m:\\n   105|        return m.group(1)\\n   106|    return href\\n   107|\\n   108|\\n   109|def fix_article_file(path: Path, dry_run: bool) -> int:\\n   110|    text = path.read_text(encoding=\\\"utf-8\\\")\\n   111|    original = text\\n   112|    changes = 0\\n   113|    slug = path.name[:-5]\\n   114|    canon = canon_for_slug(slug)\\n   115|\\n   116|    # canonical\\n   117|    new, n = re.subn(\\n   118|        r'<link rel=\\\"canonical\\\" href=\\\"[^\\\"]+\\\"\\\\s*/?>',\\n   119|        f'<link rel=\\\"canonical\\\" href=\\\"{canon}\\\">',\\n   120|        text, count=1,\\n   121|    )\\n   122|    if n:\\n   123|        text = new\\n   124|        changes += n\\n   125|\\n   126|    # og:url\\n   127|    new, n = re.subn(\\n   128|        r'<meta property=\\\"og:url\\\" content=\\\"[^\\\"]+\\\"\\\\s*/?>',\\n   129|        f'<meta property=\\\"og:url\\\" content=\\\"{canon}\\\">',\\n   130|        text, count=1,\\n   131|    )\\n   132|    if n:\\n   133|        text = new\\n   134|        changes += n\\n   135|\\n   136|    # inter-article hrefs (only inside /artikel/ and pointing to real slugs)\\n   137|    def _href_sub(m):\\n   138|        attr, href = m.group(1), m.group(2)\\n   139|        new_href = normalize_href(href)\\n   140|        if new_href != href:\\n   141|            mm = re.match(r\\\"^/artikel/([A-Za-z0-9_\\\\-]+)$\\\", new_href)\\n   142|            if mm and mm.group(1) in ARTICLE_SLUGS:\\n   143|                return f'{attr}=\\\"{new_href}\\\"'\\n   144|        return m.group(0)\\n   145|\\n   146|    new, n = re.subn(r'(href)=\\\"([^\\\"]+)\\\"', _href_sub, text)\\n   147|    if n:\\n   148|        text = new\\n   149|        changes += n\\n   150|\\n   151|    if text != original and not dry_run:\\n   152|        path.write_text(text, encoding=\\\"utf-8\\\")\\n   153|    return changes\\n   154|\\n   155|\\n   156|def fix_static_pages(dry_run: bool) -> int:\\n   157|    total = 0\\n   158|    for fn in [\\\"index.html\\\", \\\"about.html\\\", \\\"impressum.html\\\", \\\"datenschutz.html\\\"]:\\n   159|        p = ROOT / fn\\n   160|        if not p.exists():\\n   161|            continue\\n   162|        text = p.read_text(encoding=\\\"utf-8\\\")\\n   163|        original = text\\n   164|\\n   165|        def _href_sub(m):\\n   166|            attr, href = m.group(1), m.group(2)\\n   167|            new_href = normalize_href(href)\\n   168|            if new_href != href:\\n   169|                mm = re.match(r\\\"^/artikel/([A-Za-z0-9_\\\\-]+)$\\\", new_href)\\n   170|                if mm and mm.group(1) in ARTICLE_SLUGS:\\n   171|                    return f'{attr}=\\\"{new_href}\\\"'\\n   172|            return m.group(0)\\n   173|\\n   174|        text, n = re.subn(r'(href)=\\\"([^\\\"]+)\\\"', _href_sub, text)\\n   175|        if text != original:\\n   176|            total += n\\n   177|            if not dry_run:\\n   178|                p.write_text(text, encoding=\\\"utf-8\\\")\\n   179|    return total\\n   180|\\n   181|\\n   182|def rebuild_sitemap(dry_run: bool, mtime_cache: dict[str, float] | None = None) -> tuple[int, int]:\\n   183|    if not SITEMAP.exists():\\n   184|        return 0, 0\\n   185|    text = SITEMAP.read_text(encoding=\\\"utf-8\\\")\\n   186|    entry_re = re.compile(\\n   187|        r'(  <url>\\\\s*<loc>([^<]+)</loc>\\\\s*<lastmod>)([^<]+)(</lastmod>)(.*?</url>)',\\n   188|        re.DOTALL,\\n   189|    )\\n   190|    new_parts = ['<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\\\\n'\\n   191|                 '<urlset xmlns=\\\"http://www.sitemaps.org/schemas/sitemap/0.9\\\">']\\n   192|    seen = set()\\n   193|    kept = 0\\n   194|    static_map = {\\n   195|        f\\\"{SITE}/\\\": ROOT / \\\"index.html\\\",\\n   196|        f\\\"{SITE}/about/\\\": ROOT / \\\"about.html\\\",\\n   197|        f\\\"{SITE}/impressum/\\\": ROOT / \\\"impressum.html\\\",\\n   198|        f\\\"{SITE}/datenschutz/\\\": ROOT / \\\"datenschutz.html\\\",\\n   199|    }\\n   200|    for m in entry_re.finditer(text):\\n   201|        old_loc = m.group(2)\\n   202|        old_lastmod = m.group(3)\\n   203|        rest = m.group(5)\\n   204|        slug_m = re.search(r\\\"/artikel/([^/]+?)(?:\\\\.html|/)?$\\\", old_loc)\\n   205|        if slug_m:\\n   206|            slug = slug_m.group(1)\\n   207|            new_loc = f\\\"{SITE}/artikel/{slug}\\\"\\n   208|        else:\\n   209|            # Static URL — normalize\\n   210|            new_loc = old_loc.rstrip(\\\"/\\\") + \\\"/\\\"\\n   211|            slug = None\\n   212|        if new_loc in seen:\\n   213|            continue\\n   214|        seen.add(new_loc)\\n   215|        if slug and (ART_DIR / f\\\"{slug}.html\\\").exists():\\n   216|            # Best source: dateModified from JSON-LD inside the article.\\n   217|            # Fallback: cached mtime, then file mtime.\\n   218|            mt = _extract_date_modified(ART_DIR / f\\\"{slug}.html\\\")\\n   219|            if mt is None:\\n   220|                mt = (mtime_cache or {}).get(f\\\"{slug}.html\\\")\\n   221|            if mt is None:\\n   222|                mt = (ART_DIR / f\\\"{slug}.html\\\").stat().st_mtime\\n   223|            new_lastmod = time.strftime(\\\"%Y-%m-%dT%H:%M:%S+00:00\\\", time.gmtime(mt))\\n   224|        else:\\n   225|            src = static_map.get(new_loc)\\n   226|            if src and src.exists():\\n   227|                mt = (mtime_cache or {}).get(src.name)\\n   228|                if mt is None:\\n   229|                    mt = src.stat().st_mtime\\n   230|                new_lastmod = time.strftime(\\\"%Y-%m-%dT%H:%M:%S+00:00\\\", time.gmtime(mt))\\n   231|            else:\\n   232|                new_lastmod = old_lastmod\\n   233|        new_parts.append(\\n   234|            f\\\"  <url>\\\\n    <loc>{new_loc}</loc>\\\\n    <lastmod>{new_lastmod}</lastmod>{rest}\\\"\\n   235|        )\\n   236|        kept += 1\\n   237|    new_parts.append(\\\"</urlset>\\\\n\\\")\\n   238|    new_text = \\\"\\\\n\\\".join(new_parts) + \\\"\\\\n\\\"\\n   239|    if not dry_run:\\n   240|        SITEMAP.write_text(new_text, encoding=\\\"utf-8\\\")\\n   241|    return kept, len(re.findall(r\\\"<lastmod>([^<]+)</lastmod>\\\", new_text))\\n   242|\\n   243|\\n   244|def ping_indexnow() -> dict:\\n   245|    if not INDEXNOW_KEY:\\n   246|        return {\\\"status\\\": \\\"skipped\\\", \\\"body\\\": \\\"no INDEXNOW_KEY env var set\\\"}\\n   247|    payload = {\\n   248|        \\\"host\\\": \\\"haustierzentrum.com\\\",\\n   249|        \\\"key\\\": INDEXNOW_KEY,\\n   250|        \\\"keyLocation\\\": f\\\"https://haustierzentrum.com/{INDEXNOW_KEY}.txt\\\",\\n   251|        \\\"urlList\\\": [f\\\"{SITE}/sitemap.xml\\\"],\\n   252|    }\\n   253|    req = urllib.request.Request(\\n   254|        \\\"https://api.indexnow.org/indexnow\\\",\\n   255|        data=json.dumps(payload).encode(\\\"utf-8\\\"),\\n   256|        headers={\\\"Content-Type\\\": \\\"application/json; charset=utf-8\\\"},\\n   257|        method=\\\"POST\\\",\\n   258|    )\\n   259|    try:\\n   260|        with urllib.request.urlopen(req, timeout=15) as r:\\n   261|            return {\\\"status\\\": r.status, \\\"body\\\": r.read().decode(\\\"utf-8\\\", \\\"ignore\\\")[:200]}\\n   262|    except urllib.error.HTTPError as e:\\n   263|        return {\\\"status\\\": e.code, \\\"body\\\": e.read().decode(\\\"utf-8\\\", \\\"ignore\\\")[:200]}\\n   264|    except Excepti