      "snippet": "{\"content\": \"     1|#!/usr/bin/env python3\\n     2|\\\"\\\"\\\"\\n     3|_refresh_indexing.py — Normalize URLs + refresh sitemap + ping search engines.\\n     4|\\n     5|Goal: every article has ONE canonical URL = https://haustierzentrum.com/artikel/<slug>\\n     6|(no .html, no trailing slash, no /artikel/-prefix bugs)\\n     7|\\n     8|This is what Cloudflare serves after 308 redirects, so picking this as canonical\\n     9|removes duplicate-URL confusion for Google and saves 2 redirects per inbound link.\\n    10|\\\"\\\"\\\"\\n    11|from __future__ import annotations\\n    12|import argparse\\n    13|import json\\n    14|import os\\n    15|import re\\n    16|import sys\\n    17|import time\\n    18|import urllib.request\\n    19|import urllib.error\\n    20|from pathlib import Path\\n    21|\\n    22|ROOT = Path(r\\\"C:\\\\sidekick\\\\home\\\\spaces\\\\haustier-zentrum\\\")\\n    23|ART_DIR = ROOT / \\\"artikel\\\"\\n    24|SITEMAP = ROOT / \\\"sitemap.xml\\\"\\n    25|SITE = \\\"https://haustierzentrum.com\\\"\\n    26|INDEXNOW_KEY = os.environ.get(\\\"INDEXNOW_KEY\\\", \\\"\\\")\\n    27|\\n    28|# Article slug set (only files actually in /artikel/)\\n    29|ARTICLE_SLUGS = {p.name[:-5] for p in ART_DIR.glob(\\\"*.html\\\")}\\n    30|# Slug that was historically a buggy og:url (no /artikel/ prefix)\\n    31|KNOWN_BAD_SLUGS = set(ARTICLE_SLUGS)\\n    32|\\n    33|\\n    34|def canon_for_slug(slug: str) -> str:\\n    35|    return f\\\"{SITE}/artikel/{slug}\\\"\\n    36|\\n    37|\\n    38|def _extract_date_modified(path: Path) -> float | None:\\n    39|    \\\"\\\"\\\"Try to find dateModified or datePublished in JSON-LD of an article.\\n    40|    Returns a unix timestamp or None.\\\"\\\"\\\"\\n    41|    try:\\n    42|        text = path.read_text(encoding=\\\"utf-8\\\")\\n    43|    except Exception:\\n    44|        return None\\n    45|    # Find the first script type=application/ld+json\\n    46|    m = re.search(r'<script[^>]*type=\\\"application/ld\\\\+json\\\"[^>]*>(.*?)</script>', text, re.DOTALL)\\n    47|    if not m:\\n    48|        return None\\n    49|    blob = m.group(1).strip()\\n    50|    # Try direct JSON first\\n    51|    data = None\\n    52|    try:\\n    53|        data = json.loads(blob)\\n    54|    except Exception:\\n    55|        # Sometimes HTML-escaped; try a relaxed parse\\n    56|        try:\\n    57|            data = json.loads(blob.replace(\\\"&quot;\\\", '\\\"').replace(\\\"&amp;\\\", \\\"&\\\"))\\n    58|        except Exception:\\n    59|            return None\\n    60|    # Search for dateModified or datePublished recursively\\n    61|    target = None\\n    62|    def walk(o):\\n    63|        nonlocal target\\n    64|        if isinstance(o, dict):\\n    65|            if \\\"dateModified\\\" in o:\\n    66|                target = o[\\\"dateModified\\\"]\\n    67|                return True\\n    68|            if \\\"datePublished\\\" in o and target is None:\\n    69|                target = o[\\\"datePublished\\\"]\\n    70|            for v in o.values():\\n    71|                if walk(v):\\n    72|                    return True\\n    73|        elif isinstance(o, list):\\n    74|            for v in o:\\n    75|                if walk(v):\\n    76|                    return True\\n    77|        return False\\n    78|    walk(data)\\n    79|    if not target:\\n    80|        return None\\n    81|    # Parse ISO date; if date-only, treat as midnight UTC\\n    82|    s = str(target)\\n    83|    try:\\n    84|        if re.match(r\\\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\\\", s):\\n    85|            return time.mktime(time.strptime(s, \\\"%Y-%m-%d\\\"))\\n    86|        return time.mktime(time.strptime(s[:19], \\\"%Y-%m-%dT%H:%M:%S\\\"))\\n    87|    except Exception:\\n    88|        return None\\n    89|\\n    90|\\n    91|def normalize_href(href: str) -> str:\\n    92|    \\\"\\\"\\\"Collapse .../artikel/foo.html and .../artikel/foo/ to .../artikel/foo.\\\"\\\"\\\"\\n    93|    if not href:\\n    94|        return href\\n    95|    h = href\\n    96|    if h.startswith(SITE):\\n    97|        h = h[len(SITE):]\\n    98|    elif h.startswith(\\\"https://www.haustier-zentrum.com\\\"):\\n    99|       ",
