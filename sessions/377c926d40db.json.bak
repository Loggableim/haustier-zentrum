      "content": "{\"content\": \"     1|<!DOCTYPE html>\\n     2|<html lang=\\\"de\\\">\\n     3|<head>\\n     4|<meta charset=\\\"UTF-8\\\">\\n     5|<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n     6|  <link rel=\\\"alternate\\\" type=\\\"application/rss+xml\\\" title=\\\"Haustierzentrum RSS Feed\\\" href=\\\"https://haustierzentrum.com/rss.xml\\\">\\n     7|<title>Impressum – Haustierzentrum</title>\\n     8|<meta name=\\\"description\\\" content=\\\"Impressum der Website Haustierzentrum – Angaben gemäß §5 TMG.\\\">\\n     9|<meta property=\\\"og:title\\\" content=\\\"Impressum – Haustierzentrum\\\">\\n    10|<meta property=\\\"og:url\\\" content=\\\"https://haustierzentrum.com/impressum.html\\\">\\n    11|<meta property=\\\"og:type\\\" content=\\\"website\\\">\\n    12|<meta property=\\\"og:site_name\\\" content=\\\"Haustierzentrum\\\">\\n    13|<meta name=\\\"robots\\\" content=\\\"index, follow\\\">\\n    14|<link rel=\\\"canonical\\\" href=\\\"https://haustierzentrum.com/impressum.html\\\">\\n    15|<script type=\\\"application/ld+json\\\">\\n    16|{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebPage\\\",\\\"name\\\":\\\"Impressum\\\",\\\"isPartOf\\\":{\\\"@type\\\":\\\"WebSite\\\",\\\"name\\\":\\\"Haustierzentrum\\\",\\\"url\\\":\\\"https://haustierzentrum.com\\\"}}\\n    17|</script>\\n    18|<style>\\n    19|:root{--primary:#FF9800;--primary-dark:#e68900;--primary-light:#fff3e0;--bg:#ffffff;--bg-alt:#f7f7f7;--text:#1a1a1a;--text-muted:#666;--border:#e0e0e0;--border-light:#e8e0d0;--card-shadow:0 2px 12px rgba(0,0,0,.08);--font:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}\\n    20|*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\\n    21|html{scroll-behavior:smooth}\\n    22|body{font-family:var(--font);color:var(--text);background:var(--bg);line-height:1.7;display:flex;flex-direction:column;min-height:100vh}\\n    23|a{color:var(--primary);text-decoration:none}\\n    24|img{max-width:100%;height:auto;display:block}\\n    25|.site-header{background:var(--bg);border-bottom:3px solid var(--primary);padding:0 1rem;position:sticky;top:0;z-index:1000}\\n    26|.nav-wrap{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:64px}\\n    27|.logo{font-size:1.4rem;font-weight:800;color:var(--primary);letter-spacing:-.5px;flex-shrink:0}\\n    28|.logo:hover{text-decoration:none}\\n    29|.main-nav{display:flex;align-items:center}\\n    30|.nav-links{display:flex;gap:0;list-style:none;align-items:center;margin:0;padding:0}\\n    31|.nav-links>li{position:relative}\\n    32|.nav-links>li>a{color:var(--text);font-weight:600;font-size:.85rem;padding:.4rem .75rem;border-radius:50px;transition:.2s;letter-spacing:.2px;display:flex;align-items:center;gap:.3rem;white-space:nowrap}\\n    33|.nav-links>li>a .arrow{font-size:.6rem;transition:transform .25s;display:inline-block}\\n    34|.nav-links>li:hover>a .arrow{transform:rotate(180deg)}\\n    35|.nav-links>li>a:hover,.nav-links>li>a.active{color:#fff;background:var(--primary);text-decoration:none}\\n    36|.nav-links>li.simple-link>a{color:var(--text-muted);font-weight:500;font-size:.8rem}\\n    37|.nav-links>li.simple-link>a:hover{color:#fff}\\n    38|.mega-panel{position:absolute;top:100%;left:50%;transform:translateX(-50%) translateY(12px);background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.15),0 4px 20px rgba(0,0,0,.06);min-width:680px;max-width:900px;padding:0;opacity:0;visibility:hidden;transition:all .25s cubic-bezier(.16,1,.3,1);border:1px solid var(--border);overflow:hidden;pointer-events:none}\\n    39|.nav-links>li:hover .mega-panel{opacity:1;visibility:visible;transform:translateX(-50%) translateY(8px);pointer-events:auto}\\n    40|.mega-grid{display:grid;gap:0;padding:1.5rem}\\n    41|.mega-grid.cols-2{grid-template-columns:1fr 1fr}\\n    42|.mega-grid.cols-3{grid-template-columns:1fr 1fr 1fr}\\n    43|.mega-grid.cols-4{grid-template-columns:1fr 1fr 1fr 1fr}\\n    44|.mega-col{padding:0 .8rem;border-right:1px solid var(--border)}\\n    45|.mega-col:last-child{border-right:none}\\n    46|.mega-col h4{font-size:.7rem;text-transform:uppercase;letter-spacing:1px;color:var(--primary);font-weight:700;margin:0 0 .6rem 0;padding-bottom:.4rem;border-bottom:2px solid var(--primary-light)}\\n    47|.mega-col a{display:flex;align-items:center;gap:.4rem;padding:.35rem .5rem;border-radius:8px;color:var(--text);font-size:.82rem;font-weight:500;transition:all .15s;text-decoration:none;line-height:1.3}\\n    48|.mega-col a:hover{background:var(--primary-light);color:var(--primary-dark);text-decoration:none}\\n    49|.mega-col a .badge{font-size:.6rem;background:var(--primary);color:#fff;padding:.1rem .4rem;border-radius:20px;font-weight:700;margin-left:auto;animation:pulse-badge 2s infinite}\\n    50|@keyframes pulse-badge{0%,100%{opacity:1}50%{opacity:.6}}\\n    51|.mega-featured{background:linear-gradient(135deg,var(--primary-light),#fff8e1);border-radius:12px;padding:.8rem 1rem;margin-top:.6rem;display:flex;align-items:center;gap:.8rem}\\n    52|.mega-featured img{width:52px;height:52px;border-radius:8px;object-fit:cover;flex-shrink:0}\\n    53|.mega-featured .meta{flex:1}\\n    54|.mega-featured .meta strong{display:block;font-size:.82rem;color:var(--text)}\\n    55|.mega-featured .meta span{font-size:.7rem;color:var(--text-muted)}\\n    56|.search-btn{background:none;border:none;font-size:1.1rem;cursor:pointer;color:var(--text-muted);padding:.4rem .6rem;border-radius:50px;transition:.2s;display:flex;align-items:center}\\n    57|.search-btn:hover{background:var(--primary-light);color:var(--primary)}\\n    58|.nav-toggle{display:none;background:none;border:none;font-size:1.6rem;cursor:pointer;color:var(--text);padding:.25rem}\\n    59|main{flex:1;max-width:1100px;margin:0 auto;padding:2rem 1rem;width:100%}\\n    60|.info-page{max-width:780px;margin:0 auto}\\n    61|.info-page h1{font-size:2rem;margin-bottom:1rem;color:var(--primary-dark)}\\n    62|.info-page h2{font-size:1.3rem;margin:2rem 0 .8rem}\\n    63|.info-page p{margin-bottom:1rem}\\n    64|.info-page address{font-style:normal;margin-bottom:1rem;line-height:2}\\n    65|.site-footer{background:#1a1a1a;color:#ccc;padding:2rem 1rem;margin-top:3rem;font-size:.88rem}\\n    66|.footer-wrap{max-width:1100px;margin:0 auto;display:flex;flex-wrap:wrap;gap:2rem;justify-content:space-between;align-items:center}\\n    67|.footer-wrap a{color:#FFB74D}\\n    68|.footer-copy{text-align:center;width:100%;margin-top:1rem;padding-top:1rem;border-top:1px solid #333;font-size:.82rem}\\n    69|.cookie-banner{position:fixed;bottom:0;left:0;right:0;background:#1a1a1a;color:#eee;padding:1rem 1.5rem;display:none;z-index:999;font-size:.9rem}\\n    70|.cookie-banner.show{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:1rem}\\n    71|.cookie-banner button{background:var(--primary);border:none;color:#fff;font-weight:600;padding:.5rem 1.5rem;border-radius:6px;cursor:pointer}\\n    72|@media(max-width:900px){\\n    73|  .main-nav{position:fixed;top:64px;left:0;right:0;bottom:0;background:rgba(255,255,255,.98);backdrop-filter:blur(20px);flex-direction:column;padding:1rem;overflow-y:auto;transform:translateX(100%);transition:transform .35s cubic-bezier(.16,1,.3,1);z-index:999}\\n    74|  .main-nav.open{transform:translateX(0)}\\n    75|  .nav-links{flex-direction:column;width:100%;gap:0}\\n    76|  .nav-links>li{width:100%}\\n    77|  .nav-links>li>a{padding:.8rem 1rem;border-radius:12px;font-size:.95rem;justify-content:space-between}\\n    78|  .nav-links>li>a .arrow{font-size:.8rem}\\n    79|  .mega-panel{position:static;transform:none;opacity:1;visibility:visible;box-shadow:none;border:none;border-radius:0;min-width:auto;max-width:100%;padding:0;max-height:0;overflow:hidden;transition:max-height .35s;pointer-events:auto;background:var(--bg-alt);margin:0;border-radius:12px}\\n    80|  .nav-links>li.open .mega-pa