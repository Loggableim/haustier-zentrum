      "content": "{\"content\": \"     1|<!DOCTYPE html>\\n     2|<html lang=\\\"de\\\">\\n     3|<head>\\n     4|<meta charset=\\\"UTF-8\\\">\\n     5|<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n     6|<title>Hunderassen für Anfänger – Welcher Hund passt zu mir? | Haustierzentrum</title>\\n     7|<meta name=\\\"description\\\" content=\\\"Die besten Hunderassen für Anfänger: Welcher Hund passt zu Dir? Umfassender Ratgeber mit Rasseprofilen, Checkliste, Vergleichstabelle und Tipps für die richtige Wahl.\\\">\\n     8|<meta property=\\\"og:title\\\" content=\\\"Hunderassen für Anfänger – Welcher Hund passt zu mir?\\\">\\n     9|<meta property=\\\"og:description\\\" content=\\\"Welcher Hund ist der richtige für Einsteiger? Labrador, Golden Retriever, Französische Bulldogge oder doch ein Mops? Der große Anfänger-Ratgeber mit allen Rasseprofilen.\\\">\\n    10|<meta property=\\\"og:url\\\" content=\\\"https://haustierzentrum.com/artikel/hunderassen-anfaenger.html\\\">\\n    11|<meta property=\\\"og:type\\\" content=\\\"article\\\">\\n    12|    <meta property=\\\"og:image\\\" content=\\\"../images/hunderassen-anfaenger_00001_.png\\\">\\n    13|<meta property=\\\"og:site_name\\\" content=\\\"Haustierzentrum\\\">\\n    14|<meta name=\\\"robots\\\" content=\\\"index, follow\\\">\\n    15|<link rel=\\\"canonical\\\" href=\\\"https://haustierzentrum.com/artikel/hunderassen-anfaenger.html\\\">\\n    16|<script type=\\\"application/ld+json\\\">\\n    17|{\\n    18|  \\\"@context\\\": \\\"https://schema.org\\\",\\n    19|  \\\"@type\\\": \\\"BlogPosting\\\",\\n    20|  \\\"headline\\\": \\\"Hunderassen für Anfänger – Welcher Hund passt zu mir?\\\",\\n    21|  \\\"description\\\": \\\"Die besten Hunderassen für Anfänger: Welcher Hund passt zu Dir? Umfassender Ratgeber mit Rasseprofilen, Checkliste, Vergleichstabelle und Tipps für die richtige Wahl.\\\",\\n    22|  \\\"author\\\": {\\\"@type\\\":\\\"Person\\\",\\\"name\\\":\\\"Haustierzent