      "snippet": "{\"content\": \"     1|#!/usr/bin/env python3\\n     2|\\\"\\\"\\\"Generate colored pencil sketch style hero images for Haustierzentrum articles.\\n     3|Uses ComfyUI API if available, otherwise Pillow fallback with sketch aesthetic.\\\"\\\"\\\"\\n     4|from pathlib import Path\\n     5|import sys, hashlib, textwrap, json, time, uuid, requests\\n     6|try:\\n     7|    from PIL import Image, ImageDraw, ImageFont\\n     8|except ImportError:\\n     9|    raise SystemExit(\\\"Pillow is required: pip install pillow\\\")\\n    10|\\n    11|API_BASE = \\\"http://127.0.0.1:8188\\\"\\n    12|CLIENT_ID = str(uuid.uuid4())\\n    13|\\n    14|WORKFLOW_TEMPLATE = {\\n    15|    \\\"3\\\": {\\\"class_type\\\": \\\"KSampler\\\", \\\"inputs\\\": {\\\"seed\\\": 42, \\\"steps\\\": 25, \\\"cfg\\\": 7, \\\"sampler_name\\\": \\\"euler\\\", \\\"scheduler\\\": \\\"normal\\\", \\\"denoise\\\": 1, \\\"model\\\": [\\\"4\\\", 0], \\\"positive\\\": [\\\"6\\\", 0], \\\"negative\\\": [\\\"7\\\", 0], \\\"latent_image\\\": [\\\"5\\\", 0]}},\\n    16|    \\\"4\\\": {\\\"class_type\\\": \\\"CheckpointLoaderSimple\\\", \\\"inputs\\\": {\\\"ckpt_name\\\": \\\"sd_xl_base_1.0.safetensors\\\"}},\\n    17|    \\\"5\\\": {\\\"class_type\\\": \\\"EmptyLatentImage\\\", \\\"inputs\\\": {\\\"width\\\": 1024, \\\"height\\\": 768, \\\"batch_size\\\": 1}},\\n    18|    \\\"6\\\": {\\\"class_type\\\": \\\"CLIPTextEncode\\\", \\\"inputs\\\": {\\\"text\\\": \\\"\\\", \\\"clip\\\": [\\\"4\\\", 1]}},\\n    19|    \\\"7\\\": {\\\"class_type\\\": \\\"CLIPTextEncode\\\", \\\"inputs\\\": {\\\"text\\\": \\\"photorealistic, 3d render, photograph, realistic texture\\\", \\\"clip\\\": [\\\"4\\\", 1]}},\\n    20|    \\\"8\\\": {\\\"class_type\\\": \\\"VAEDecode\\\", \\\"inputs\\\": {\\\"samples\\\": [\\\"3\\\", 0], \\\"vae\\\": [\\\"4\\\", 2]}},\\n    21|    \\\"9\\\": {\\\"class_type\\\": \\\"SaveImage\\\", \\\"inputs\\\": {\\\"filename_prefix\\\": \\\"comfy\\\", \\\"images\\\": [\\\"8\\\", 0]}}\\n    22|}\\n    23|\\n    24|SKETCH_PROMPT = \\\"Colored pencil sketch drawing on cream paper of {s}, hand-drawn illustration style, soft pastel colors, warm tones, gentle artistic strokes, children's book illustration, cute and charming, high quality colored pencil artwork\\\"\\n    25|\\n    26|def font(size, bold=False):\\n    27|    candidates = [\\n    28|        \\\"/c/Windows/Fonts/segoeuib.ttf\\\" if bold else \\\"/c/Windows/Fonts/segoeui.ttf\\\",\\n    29|        \\\"/c/Windows/Fonts/arialbd.ttf\\\" if bold else \\\"/c/Windows/Fonts/arial.ttf\\\",\\n    30|    ]\\n    31|    for p in candidates:\\n    32|        if Path(p).exists():\\n    33|            return ImageFont.truetype(p, size)\\n    34|    return ImageFont.load_default()\\n    35|\\n    36|def generate_via_comfyui(slug, subject, outdir):\\n    37|    \\\"\\\"\\\"Generate image via ComfyUI API with colored pencil sketch style.\\\"\\\"\\\"\\n    38|    try:\\n    39|        w = json.loads(json.dumps(WORKFLOW_TEMPLATE))\\n    40|        w[\\\"3\\\"][\\\"inputs\\\"][\\\"seed\\\"] = abs(hash(slug)) % (2**31)\\n    41|        w[\\\"6\\\"][\\\"inputs\\\"][\\\"text\\\"] = SKETCH_PROMPT.format(s=subject)\\n    42|        r = requests.post(f\\\"{API_BASE}/prompt\\\", json={\\\"prompt\\\": w, \\\"client_id\\\": CLIENT_ID}, timeout=15)\\n    43|        pid = r.json()[\\\"prompt_id\\\"]\\n    44|        for _ in range(60):\\n    45|            r2 = requests.get(f\\\"{API_BASE}/history/{pid}\\\", timeout=10)\\n    46|            if r2.status_code == 200 and pid in r2.json():\\n    47|                for nid, no in r2.json()[pid].get(\\\"outputs\\\", {}).items():\\n    48|                    for img in no.get(\\\"images\\\", []):\\n    49|                        src = Path(f\\\"C:/HermesPortable/ComfyUI/output/{img['filename']}\\\")\\n    50|                        dst = outdir / f\\\"{slug}_00001_.png\\\"\\n    51|                        if src.exists():\\n    52|                            import shutil\\n    53|                            shutil.copy2(src, dst)\\n    54|                            return True\\n    55|            time.sleep(2)\\n    56|    except Exception as e:\\n    57|        print(f\\\"ComfyUI failed: {e}\\\", file=sys.stderr)\\n    58|    return False\\n    59|\\n    60|def generate_fallback(slug, title, outdir):\\n    61|    \\\"\\\"\\\"Pillow fallback: sketch-style colored pencil aesthetic placeholder.\\\"\\\"\\\"\\n    62|    digest = hashlib.md5(slu",
