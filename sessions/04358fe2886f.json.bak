            "name": "write_file",
            "arguments": "{\"content\": \"import os, re\\nfrom PIL import Image\\n\\nBASE_ART = \\\"C:/HermesPortable/home/spaces/haustier-zentrum/artikel\\\"\\nBASE_IMG = \\\"C:/HermesPortable/home/spaces/haustier-zentrum/images\\\"\\n\\n# Check which images the articles reference vs what exists and their style\\nall_articles = sorted([f for f in os.listdir(BASE_ART) if f.endswith(\\\".html\\\")])\\n\\nprint(\\\"=== ARTICLE IMAGE AUDIT ===\\\")\\nprint(f\\\"{'Article':45s} {'Ref Image':40s} {'Exists':8s} {'Size':8s} {'Dim':12s} {'Style'}\\\")\\nprint(\\\"-\\\"*125)\\n\\nissues = []\\nfor art in all_articles:\\n    path = os.path.join(BASE_ART, art)\\n    content = open(path, 'r', encoding='utf-8').read()\\n    \\n    # Find featured-img img src\\n    imgs = re.findall(r'<div class=\\\"featured-img\\\">.*?src=\\\"\\\\.\\\\./images/([^\\\"]+)\\\"', content, re.DOTALL)\\n    if not imgs:\\n        imgs = re.findall(r'src=\\\"\\\\.\\\\./images/([^\\\"]+)\\\"', content)\\n    \\n    for img in imgs:\\n        if 'favicon' in img or 'logo' in img:\\n            continue\\n        \\n        # Check file\\n        full_path = os.path.join(BASE_IMG, img)\\n        \\n        if not os.path.exists(full_path):\\n            print(f\\\"{art:45s} {img:40s} MISSING  {'-':8s} {'-':12s} ❌\\\")\\n            issues.append((art, img, 'MISSING'))\\n            continue\\n        \\n        sz = os.path.getsize(full_path)\\n        try:\\n            im = Image.open(full_path)\\n            w, h = im.size\\n            dim = f\\\"{w}x{h}\\\"\\n            \\n            # Determine style by dimension and size\\n            if w == 768 and h == 576:\\n                style = \\\"✅ CORRECT (768x576)\\\"\\n            elif w == 1024 and h == 768:\\n                if sz < 20000:\\n                    style = \\\"❌ Gradient silhouette (too small)\\\"\\n                else:\\n                    style = \\\"❌ WRONG dim (1024x768)\\\"\\n            else:\\n                style = f\\\"❌ WRONG dim ({w}x{h})\\\"\\n            \\n            print(f\\\"{art:45s} {img:40s} {sz//1024:>4d}KB {dim:12s} {style}\\\")\\n            \\n            if '❌' in style:\\n                issues.append((art, img, style))\\n                \\n        except:\\n            print(f\\\"{art:45s} {img:40s} ERROR    {'-':8s} {'-':12s} ❌\\\")\\n\\nprint(f\\\"\\\\n{'='*60}\\\")\\nprint(f\\\"ISSUES FOUND: {len(issues)}\\\")\\nfor art, img, reason in issues:\\n    print(f\\\"  ❌ {art} -> {img}: {reason}\\\")\\n\", \"path\": \"C:/HermesPortable/home/tmp/audit_images_final.py\"}"
