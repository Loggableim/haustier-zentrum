.get('error', '')}\\\")\\n    else:\\n        # Check if it already has an image\\n        img_match = re.search(r'<div class=\\\"featured-img\\\">.*?src=\\\"([^\\\"]+)\\\"', content)\\n        if img_match:\\n            print(f\\\"ℹ️  {art_file} - already has image: {img_match.group(1)}\\\")\\n        else:\\n            print(f\\\"⚠️  {art_file} - no featured-img SVG found\\\")\\n\"}"
