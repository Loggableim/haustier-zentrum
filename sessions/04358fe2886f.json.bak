    {
      "name": "read_file",
      "snippet": "{\"content\": \"   423|    </div>\\n   424|\\n   425|    <div class=\\\"featured-img\\\">\\n   426|      <img src=\\\"../images/kleintiere_00001_.webp\\\" alt=\\\"Hamster und Meerschweinchen\\\" class=\\\"hero-image\\\" style=\\\"width:100%;height:auto;border-radius:12px;\\\">\\n   427|    </div>\\n   428|\", \"total_lines\": 614, \"file_size\": 21843, \"truncated\": true, \"hint\": \"Use offset=428 to continue reading (showing 423-427 of 614 lines)\", \"is_binary\": false, \"is_image\": false}",
