            "name": "write_file",
            "arguments": "{\"content\": \"from PIL import Image, ImageDraw\\n\\ndef create_hero_image(color_top, color_bot, width=1024, height=768):\\n    \\\"\\\"\\\"Create a hero image in the Haustierzentrum design language.\\\"\\\"\\\"\\n    img = Image.new('RGB', (width, height))\\n    pixels = img.load()\\n    \\n    for y in range(height):\\n        t = y / height\\n        r = int(color_top[0] * (1-t) + color_bot[0] * t)\\n        g = int(color_top[1] * (1-t) + color_bot[1] * t)\\n        b = int(color_top[2] * (1-t) + color_bot[2] * t)\\n        for x in range(width):\\n            pixels[x, y] = (r, g, b)\\n    \\n    center_x, center_y = width // 2, height // 2\\n    ellipse_width = 440\\n    ellipse_height = 280\\n    \\n    draw = ImageDraw.Draw(img)\\n    draw.ellipse(\\n        [center_x - ellipse_width//2, center_y - ellipse_height//2,\\n         center_x + ellipse_width//2, center_y + ellipse_height//2],\\n        fill=(255, 255, 255)\\n    )\\n    \\n    img = img.quantize(colors=256, method=Image.MEDIANCUT)\\n    return img.convert('RGB')\\n\\n# Color themes - each species gets its own palette\\nTHEMES = {\\n    'chihuahua': ((210, 165, 125), (150, 100, 60)),\\n    'deutscher-schaeferhund-rasseguide': ((100, 100, 110), (55, 50, 45)),\\n    'franzoesische-bulldogge-rasseguide': ((190, 145, 130), (130, 85, 70)),\\n    'golden-retriever-rasseguide': ((230, 140, 70), (150, 80, 20)),\\n    'hundeerziehung-grundlagen': ((180, 180, 200), (120, 120, 140)),\\n    'katzenbeschaeftigung': ((200, 150, 120), (140, 90, 60)),\\n    'katzenhaltung-wohnung': ((170, 140, 160), (110, 80, 100)),\\n    'kleintiere-hamster-meerschweinchen': ((140, 180, 140), (80, 120, 80)),\\n    'maine-coon-katze-rasseguide': ((160, 110, 90), (95, 55, 45)),\\n}\\n\\nBASE = \\\"C:/HermesPortable/home/spaces/haustier-zentrum/images\\\"\\n\\nfor slug, (top, bot) in THEMES.items():\\n    img = create_hero_image(top, bot)\\n    # Save as PNG source\\n    png_path = f\\\"{BASE}/{slug}_00001_.png\\\"\\n    img.save(png_path, 'PNG')\\n    # Convert to WebP\\n    webp_path = png_path.replace('.png', '.webp')\\n    img.save(webp_path, 'WEBP', quality=82, method=6)\\n    print(f\\\"✅ {slug}_00001_ ({img.size[0]}x{img.size[1]})\\\")\\n\\nprint(\\\"\\\\n🎉 All done!\\\")\\n\", \"path\": \"C:/HermesPortable/home/tmp/generate_all_missing.py\"}"
