            "arguments": "{\"code\": \"\\nimport urllib.request, json, time, os\\n\\nAPI_KEY = \\\"njolKkbw88RDSESdriVoqg\\\"\\nHORDE_URL = \\\"https://stablehorde.net/api/v2\\\"\\nSAVE_PATH = \\\"C:/HermesPortable/home/spaces/haustier-zentrum/images/reptilien-haustier-anfaenger-vergleich-2026_00001_.webp\\\"\\n\\ndef horde_request(method, path, data=None):\\n    url = f\\\"{HORDE_URL}{path}\\\"\\n    headers = {\\\"Content-Type\\\": \\\"application/json\\\", \\\"apikey\\\": API_KEY}\\n    body = json.dumps(data).encode() if data else None\\n    req = urllib.request.Request(url, data=body, headers=headers, method=method)\\n    with urllib.request.urlopen(req, timeout=120) as resp:\\n        return json.loads(resp.read())\\n\\nprompt = \\\"professional photograph of three pet reptiles arranged on natural background, left side a Greek tortoise on green grass, center a bearded dragon on warm sandstone, right side a leopard gecko on desert sand, warm sunlight, sharp focus, high detail, 8K, educational pet blog style, bright inviting atmosphere\\\"\\n\\nresult = horde_request(\\\"POST\\\", \\\"/generate/async\\\", {\\n    \\\"prompt\\\": prompt,\\n    \\\"params\\\": {\\n        \\\"steps\\\": 30,\\n        \\\"cfg_scale\\\": 7,\\n        \\\"width\\\": 1024,\\n        \\\"height\\\": 576,\\n        \\\"sampler_name\\\": \\\"k_euler_a\\\"\\n    },\\n    \\\"models\\\": [\\\"AlbedoBase XL (SDXL)\\\"],\\n    \\\"r2\\\": True\\n})\\n\\njob_id = result[\\\"id\\\"]\\nprint(f\\\"Job ID: {job_id}\\\")\\nprint(\\\"Waiting for generation...\\\")\\n\\nwaited = 0\\nwhile True:\\n    status = horde_request(\\\"GET\\\", f\\\"/generate/status/{job_id}\\\")\\n    done = status.get(\\\"done\\\", False)\\n    finished = status.get(\\\"finished\\\", 0)\\n    processing = status.get(\\\"processing\\\", 0)\\n    queue_pos = status.get(\\\"queue_position\\\", 0)\\n    kudos = status.get(\\\"kudos\\\", 0)\\n    \\n    print(f\\\"  waited {waited}s | finished:{finished} processing:{processing} queue_pos:{queue_pos} kudos:{kudos}\\\")\\n    \\n    if done:\\n        break\\n    \\n    if waited > 300:\\n        print(\\\"TIMEOUT - giving up\\\")\\n        break\\n    \\n    time.sleep(5)\\n    waited += 5\\n\\nif done:\\n    generations = status.get(\\\"generations\\\", [])\\n    if generations:\\n        img_url = generations[0][\\\"img\\\"]\\n        print(f\\\"Downloading from: {img_url}\\\")\\n        \\n        # Download and save\\n        req = urllib.request.Request(img_url, headers={\\\"User-Agent\\\": \\\"Mozilla/5.0\\\"})\\n        with urllib.request.urlopen(req, timeout=60) as resp:\\n            img_data = resp.read()\\n        \\n        os.makedirs(os.path.dirname(SAVE_PATH), exist_ok=True)\\n        with open(SAVE_PATH, \\\"wb\\\") as f:\\n            f.write(img_data)\\n        \\n        file_size = os.path.getsize(SAVE_PATH)\\n        print(f\\\"Saved: {SAVE_PATH} ({file_size:,} bytes)\\\")\\n    else:\\n        print(\\\"No generations returned\\\")\\n        print(f\\\"Status: {json.dumps(status, indent=2)[:500]}\\\")\\nelse:\\n    print(f\\\"Failed after timeout. Status: {json.dumps(status, indent=2)[:500]}\\\")\\n\"}"
