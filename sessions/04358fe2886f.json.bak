= None\\n    for f in os.listdir(QUEUE_DIR):\\n        if f.startswith(jid) and f.endswith(\\\".png\\\"):\\n            src = os.path.join(QUEUE_DIR, f)\\n            break\\n    \\n    if not src:\\n        print(f\\\"❌ {slug}: NO SOURCE\\\")\\n        continue\\n    \\n    img = Image.open(src)\\n    w, h = img.size\\n    \\n    base = FILENAME_MAP.get(slug, f\\\"{slug}_00001_\\\")\\n    \\n    # Save WebP + PNG everywhere\\n    for d in [TARGET_DIR, GIT_DIR]:\\n        img.save(os.path.join(d, f\\\"{base}.webp\\\"), \\\"WEBP\\\", quality=82, method=6)\\n        img.save(os.path.join(d, f\\\"{base}.png\\\"), \\\"PNG\\\")\\n    \\n    sz = os.path.getsize(os.path.join(TARGET_DIR, f\\\"{base}.webp\\\"))\\n    \\n    # Check corners for white background\\n    corners = [img.getpixel((5,5)), img.getpixel((w-5,5)), img.getpixel((5,h-5)), img.getpixel((w-5,h-5))]\\n    avg_corner = sum(sum(c)/3 for c in corners) / 4\\n    white_bg = \\\"✅\\\" if avg_corner > 240 else \\\"⚠️\\\"\\n    \\n    print(f\\\"{white_bg} {base}.webp ({w}x{h}, {sz//1024}KB, corner_bright={avg_corner:.0f})\\\")\\n    found += 1\\n\\nprint(f\\\"\\\\nDone: {found} images saved\\\")\\n\", \"path\": \"C:/HermesPortable/home/tmp/save_realvis.py\"}"
