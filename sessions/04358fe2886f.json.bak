\\n      \\\"created_at\\\": 1780585341.463688\\n    },\\n    {\\n      \\\"id\\\": \\\"gen_047c417f16c6\\\",\\n      \\\"model\\\": \\\"sdxl-lightning\\\",\\n      \\\"prompt\\\": \\\"comic book style panel of a cheerful bird character flying f\\\",\\n      \\\"status\\\": \\\"queued\\\",\\n      \\\"created_at\\\": 1780585341.4652214\\n    },\\n    {\\n      \\\"id\\\": \\\"gen_3ad2fe76bde3\\\",\\n      \\\"model\\\": \\\"sdxl-lightning\\\",\\n      \\\"prompt\\\": \\\"comic book style panel of a friendly turtle character starti\\\",\\n      \\\"status\\\": \\\"queued\\\",\\n      \\\"created_at\\\": 1780585341.4663284\\n    },\\n    {\\n      \\\"id\\\": \\\"gen_d2e5564967a2\\\",\\n      \\\"model\\\": \\\"sdxl-lightning\\\",\\n      \\\"prompt\\\": \\\"comic book style panel of a wise owl character arranging dif\\\",\\n      \\\"status\\\": \\\"queued\\\",\\n      \\\"created_at\\\": 1780585341.4673283\\n    },\\n    {\\n      \\\"id\\\": \\\"gen_4c0e6a558710\\\",\\n      \\\"model\\\": \\\"sdxl-lightning\\\",\\n      \\\"prompt\\\": \\\"comic book style panel of a stressed hamster character surro\\\",\\n      \\\"status\\\": \\\"queued\\\",\\n      \\\"created_at\\\": 1780585341.4673283\\n    },\\n    {\\n      \\\"id\\\": \\\"gen_9759cce8b7d0\\\",\\n      \\\"model\\\": \\\"sdxl-lightning\\\",\\n      \\\"prompt\\\": \\\"comic book style panel of a relieved bunny character holding\\\",\\n      \\\"status\\\": \\\"queued\\\",\\n      \\\"created_at\\\": 1780585341.4683285\\n    },\\n    {\\n      \\\"id\\\": \\\"gen_3331a3df413e\\\",\\n      \\\"model\\\": \\\"sdxl-lightning\\\",\\n      \\\"prompt\\\": \\\"futuristic technology concept, AI neural network visualizati\\\",\\n      \\\"status\\\": \\\"queued\\\",\\n      \\\"created_at\\\": 1780586639.071257\\n    }\\n  ]\\n}QUEUE_ALIVE\", \"exit_code\": 0, \"error\": null}",
