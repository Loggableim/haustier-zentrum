      "content": "{\"content\": \"   101|.nav-links > li > a:hover,.nav-links > li > a.active{color:#fff;background:var(--primary);text-decoration:none}\\n   102|.nav-links > li.simple-link > a{color:var(--text-muted);font-weight:500;font-size:.8rem}\\n   103|.nav-links > li.simple-link > a:hover{color:#fff}\\n   104|.mega-panel{\\n   105|  position:absolute;top:100%;left:50%;\\n   106|  transform:translateX(-50%) translateY(12px);\\n   107|  background:#fff;border-radius:16px;\\n   108|  box-shadow:0 20px 60px rgba(0,0,0,.15),0 4px 20px rgba(0,0,0,.06);\\n   109|  min-width:680px;max-width:900px;padding:0;\\n   110|  opacity:0;visibility:hidden;\\n   111|  transition:all .25s cubic-bezier(.16,1,.3,1);\\n   112|  border:1px solid var(--border);overflow:hidden;pointer-events:none;\\n   113|}\\n   114|.nav-links > li:hover .mega-panel{\\n   115|  opacity:1;visibility:visible;\\n   116|  transform:translateX(-50%) translateY(8px);pointer-events:auto;\\n   117|}\\n   118|.mega-grid{display:grid;gap:0;padding:1.5rem}\\n   119|.mega-grid.cols-2{grid-template-columns:1fr 1fr}\\n   120|.mega-grid.cols-3{grid-template-columns:1fr 1fr 1fr}\\n   121|.mega-grid.cols-4{grid-template-columns:1fr 1fr 1fr 1fr}\\n   122|.mega-col{padding:0 .8rem;border-right:1px solid var(--border)}\\n   123|.mega-col:last-child{border-right:none}\\n   124|.mega-col h4{\\n   125|  font-size:.7rem;text-transform:uppercase;letter-spacing:1px;\\n   126|  color:var(--primary);font-weight:700;\\n   127|  margin:0 0 .6rem 0;padding-bottom:.4rem;\\n   128|  border-bottom:2px solid var(--primary-light);\\n   129|}\\n   130|.mega-col a{\\n   131|  display:flex;align-items:center;gap:.4rem;\\n   132|  padding:.35rem .5rem;border-radius:8px;\\n   133|  color:var(--text);font-size:.82rem;font-weight:500;\\n   134|  transition:all .15s;text-decoration:none;line-height:1.3;\\n   135|}\\n   136|.mega-col a:hover{background:var(--primary-light);color:var(--primary-dark);text-decoration:none}\\n   137|.mega-col a .badge{\\n   138|  font-size:.6rem;background:var(--primary);color:#fff;\\n   139|  padding:.1rem .4rem;border-radius:20px;font-weight:700;\\n   140|  margin-left:auto;animation:pulse-badge 2s infinite;\\n   141|}\\n   142|@keyframes pulse-badge{0%,100%{opacity:1}50%{opacity:.6}}\\n   143|.mega-featured{\\n   144|  background:linear-gradient(135deg,var(--primary-light),#fff8e1);\\n   145|  border-radius:12px;padding:.8rem 1rem;margin-top:.6rem;\\n   146|  display:flex;align-items:center;gap:.8rem;\\n   147|}\\n   148|.mega-featured img{width:52px;height:52px;border-radius:8px;object-fit:cover;flex-shrink:0}\\n   149|.mega-featured .meta{flex:1}\\n   150|.mega-featured .meta strong{display:block;font-size:.82rem;color:var(--text)}\\n   151|.mega-featured .meta span{font-size:.7rem;color:var(--text-muted)}\\n   152|.search-btn{\\n   153|  background:none;border:none;font-size:1.1rem;\\n   154|  cursor:pointer;color:var(--text-muted);\\n   155|  padding:.4rem .6rem;border-radius:50px;transition:.2s;display:flex;align-items:center;\\n   156|}\\n   157|.search-btn:hover{background:var(--primary-light);color:var(--primary)}\\n   158|.nav-toggle{display:none;background:none;border:none;font-size:1.6rem;cursor:pointer;color:var(--text);padding:.25rem;}\\n   159|\\n   160|@media(max-width:900px){\\n   161|  .main-nav{\\n   162|    position:fixed;top:64px;left:0;right:0;bottom:0;\\n   163|    background:rgba(255,255,255,.98);backdrop-filter:blur(20px);\\n   164|    flex-direction:column;padding:1rem;overflow-y:auto;\\n   165|    transform:translateX(100%);transition:transform .35s cubic-bezier(.16,1,.3,1);z-index:999;\\n   166|  }\\n   167|  .main-nav.open{transform:translateX(0)}\\n   168|  .nav-links{flex-direction:column;width:100%;gap:0}\\n   169|  .nav-links > li{width:100%}\\n   170|  .nav-links > li > a{padding:.8rem 1rem;border-radius:12px;font-size:.95rem;justify-content:space-between}\\n   171|  .nav-links > li > a .arrow{font-size:.8rem}\\n   172|  .mega-panel{\\n   173|    position:static;transform:none;opacity:1;visibility:visible;box-shadow:none;\\n   174|    border:none;border-radius:0;min-width:auto;max-width:100%;padding:0;\\n   175|    max-height:0;overflow:hidden;\\n   176|    transition:max-height .35s cubic-bezier(.16,1,.3,1),padding .35s;\\n   177|    pointer-events:auto;background:var(--bg-alt);margin:0;border-radius:12px;\\n   178|  }\\n   179|  .nav-links > li.open .mega-panel{max-height:800px;padding:.8rem;margin-bottom:.5rem}\\n   180|  .mega-grid{grid-template-columns:1fr 1fr !important;padding:.5rem;gap:.5rem}\\n   181|  .mega-col{border-right:none;padding:0}\\n   182|  .mega-col h4{font-size:.75rem;margin-bottom:.4rem}\\n   183|  .mega-col a{padding:.3rem .5rem;font-size:.85rem}\\n   184|  .search-btn{display:none}\\n   185|  .nav-toggle{display:block}\\n   186|  .nav-links > li.simple-link{border-top:1px solid var(--border);padding-top:.5rem;margin-top:.3rem}\\n   187|}\\n   188|@media(max-width:500px){.mega-grid{grid-template-columns:1fr !important}}\\n   189|main{flex:1;max-width:1100px;margin:0 auto;padding:2rem 1rem;width:100%}\\n   190|\\n   191|.article-header{margin-bottom:2rem}\\n   192|.article-header h1{font-size:2rem;line-height:1.3;margin-bottom:.5rem;color:var(--primary-dark)}\\n   193|.article-meta{display:flex;gap:1rem;flex-wrap:wrap;align-items:center;font-size:.88rem;color:var(--text-muted);margin-bottom:1rem}\\n   194|.article-meta .cats span{background:var(--primary);color:#fff;font-size:.75rem;font-weight:600;padding:.2rem .7rem;border-radius:20px;margin-right:.4rem}\\n   195|.product-card{\\n   196|  background:var(--bg);\\n   197|  border:1px solid var(--border);\\n   198|  border-radius:10px;\\n   199|  padding:1.5rem;\\n   200|  margin:1.8rem 0;\\n   201|  box-shadow:var(--card-shadow);\\n   202|}\\n   203|.product-card h3{font-size:1.2rem;margin-bottom:.5rem;color:var(--primary-dark)}\\n   204|.product-card p{margin-bottom:.6rem}\\n   205|.product-card .amazon-btn{\\n   206|  display:inline-block;\\n   207|  background:var(--primary);\\n   208|  color:#fff;\\n   209|  font-weight:600;\\n   210|  padding:.5rem 1.2rem;\\n   211|  border-radius:6px;\\n   212|  margin-top:.5rem;\\n   213|  font-size:.9rem;\\n   214|}\\n   215|.product-card .amazon-btn:hover{background:var(--primary-dark);text-decoration:none}\\n   216|.featured-img{\\n   217|  width:100%;\\n   218|  max-height:420px;\\n   219|  background:var(--bg-alt);\\n   220|  border-radius:12px;\\n   221|  display:flex;\\n   222|  align-items:center;\\n   223|  justify-content:center;\\n   224|  color:var(--text-muted);\\n   225|  margin-bottom:2rem;\\n   226|  overflow:hidden;\\n   227|  min-height:250px;\\n   228|}\\n   229|.featured-img svg{width:80px;height:80px}\\n   230|.article-content{max-width:750px;margin:0 auto}\\n   231|.article-content h2{font-size:1.5rem;margin:2rem 0 1rem;color:var(--primary-dark)}\\n   232|.article-content h3{font-size:1.2rem;margin:1.5rem 0 .8rem}\\n   233|.article-content p{margin-bottom:1.2rem}\\n   234|.article-content ul,.article-content ol{margin-bottom:1.2rem;padding-left:1.5rem}\\n   235|.article-content li{margin-bottom:.4rem}\\n   236|\\n   237|.ad-placeholder{\\n   238|  background:var(--bg-alt);\\n   239|  border:2px dashed var(--border);\\n   240|  border-radius:8px;\\n   241|  padding:2rem;\\n   242|  text-align:center;\\n   243|  margin:2rem 0;\\n   244|  color:var(--text-muted);\\n   245|  font-size:.85rem;\\n   246|}\\n   247|.ad-placeholder.amazon{\\n   248|  border-color:var(--primary);\\n   249|  background:#fff8e1;\\n   250|}\\n   251|\\n   252|.comparison-table{\\n   253|  width:100%;\\n   254|  border-collapse:collapse;\\n   255|  margin:1.5rem 0;\\n   256|  font-size:.92rem;\\n   257|}\\n   258|.comparison-table th{\\n   259|  background:var(--primary);\\n   260|  color:#fff;\\n   261|  padding:.7rem .7rem;\\n   262|  text-align:left;\\n   263|  font-weight:600;\\n   264|}\\n   265|.comparison-table td{\\n   266|  padding:.6rem .7rem;\\n   267|  border-bottom:1px solid var(--border);\\n   268|}\\n   269|.comparison-table tr:nth-child(even){background:var(--bg-alt)}\\n   270|.comparison-table tr:hover{background:#fff3e0}\\n   271|\\n   272|.related-posts{margin-top:3rem;padding-top:2rem;border-top:2px solid var(--border)}\\n   273|.related-posts h3{margin-bottom:1rem}\\n   274|.related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1.5rem}\\n   275|.related-card{\\n   276|  background:var(--bg);\\n   277|  border:1px solid var(--border);\\n   278|  border-radius:10px;\\n   279|  overflow:hidden;\\n   280|  box-shadow:var(--card-shadow);\\n   281|  transition:transform .2s;\\n   282|}\\n   283|.related-card:hover{transform:translateY(-3px)}\\n   284|.related-card .card-img{\\n   285|  height:140px;\\n   286|  background:var(--bg-alt);\\n   287|  display:flex;\\n   288|  align-items:center;\\n   289|  justify-content:center;\\n   290|}\\n   291|.related-card .card-body{padding:1rem}\\n   292|.related-card .card-body h4{font-size:1rem;margin-bottom:.4rem}\\n   293|.related-card .card-body h4 a{color:var(--text)}\\n   294|.related-card .card-body h4 a:hover{color:var(--primary);text-decoration:none}\\n   295|\\n   296|.site-footer{\\n   297|  background:#1a1a1a;\\n   298|  color:#ccc;\\n   299|  padding:2rem 1rem;\\n   300|  margin-top:3rem;\\n   301|  font-size:.88rem;\\n   302|}\\n   303|.footer-wrap{\\n   304|  max-width:1100px;\\n   305|  margin:0 auto;\\n   306|  display:flex;\\n   307|  flex-wrap:wrap;\\n   308|  gap:2rem;\\n   309|  justify-content:space-between;\\n   310|  align-items:center;\\n   311|}\\n   312|.footer-wrap a{color:#FFB74D}\\n   313|.footer-wrap a:hover{color:#fff}\\n   314|.footer-copy{text-align:center;width:100%;margin-top:1rem;padding-top:1rem;border-top:1px solid #333;font-size:.82rem}\\n   315|\\n   316|.cookie-banner{\\n   317|  position:fixed;\\n   318|  bottom:0;\\n   319|  left:0;\\n   320|  right:0;\\n   321|  background:#1a1a1a;\\n  