            "arguments": "{\"code\": \"from hermes_tools import terminal\\nimport json, urllib.request, time, os\\n\\nAPI_KEY = \\\"njolKkbw88RDSESdriVoqg\\\"\\nHORDE_URL = \\\"https://stablehorde.net/api/v2\\\"\\n\\ndef horde_request(method, path, data=None):\\n    url = f\\\"{HORDE_URL}{path}\\\"\\n    headers = {\\\"Content-Type\\\": \\\"application/json\\\", \\\"apikey\\\": API_KEY}\\n    body = json.dumps(data).encode() if data else None\\n    req = urllib.request.Request(url, data=body, headers=headers, method=method)\\n    with urllib.request.urlopen(req, timeout=120) as resp:\\n        return json.loads(resp.read())\\n\\n# Generate just 2 test images first to verify quality\\ntest_jobs = [\\n    (\\\"chihuahua-rasseguide\\\", \\\"professional pet studio photography of a cute chihuahua dog, pure white background (RGB 255,255,255), centered composition, soft studio lighting, sharp focus on eyes, high detail fur, clean white backdrop, 8K quality, photorealism\\\"),\\n]\\n\\nfor slug, prompt in test_jobs:\\n    result = horde_request(\\\"POST\\\", \\\"/generate/async\\\", {\\n        \\\"prompt\\\": prompt,\\n        \\\"params\\\": {\\\"steps\\\": 30, \\\"cfg_scale\\\": 7.5, \\\"width\\\": 768, \\\"height\\\": 576, \\\"sampler_name\\\": \\\"k_euler\\\", \\\"post_processing\\\": [\\\"facefix\\\"]},\\n        \\\"models\\\": [\\\"AlbedoBase XL (SDXL)\\\"],\\n        \\\"r2\\\": True,\\n        \\\"nsfw\\\": False,\\n    })\\n    jid = result[\\\"id\\\"]\\n    print(f\\\"✅ {slug}: {jid}\\\")\\n    \\n    # Poll for completion\\n    waited = 0\\n    while waited < 120:\\n        status = horde_request(\\\"GET\\\", f\\\"/generate/status/{jid}\\\")\\n        if status.get(\\\"done\\\"):\\n            img_url = status[\\\"generations\\\"][0][\\\"img\\\"]\\n            print(f\\\"  Got image! Downloading...\\\")\\n            \\n            req = urllib.request.Request(img_url, headers={\\\"User-Agent\\\": \\\"Mozilla/5.0\\\"})\\n            with urllib.request.urlopen